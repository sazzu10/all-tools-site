<div class="space-y-8">

  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
    <a href="/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
    <i class="fa-solid fa-chevron-right text-[10px] text-slate-400 dark:text-slate-600"></i>
    <span class="text-slate-800 dark:text-slate-200 font-semibold capitalize"><%= category ? category.name : 'Category' %></span>
  </nav>

  <!-- Category Header -->
  <% if (category) { %>
    <div class="p-6 sm:p-8 rounded-3xl glass-panel border border-slate-200 dark:border-slate-800 space-y-3">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-indigo-600 to-purple-600 text-white flex items-center justify-center text-xl shadow-lg shadow-indigo-600/25 shrink-0">
          <i class="<%= category.icon || 'fa-solid fa-folder' %>"></i>
        </div>
        <div>
          <h1 class="text-xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight"><%= category.name %></h1>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-1 font-normal"><%= category.description %></p>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Top Ad Slot Placeholder -->
  <%- include('../partials/ad-slot', { id: 'category-top-banner', format: 'banner', label: 'Sponsored Placement' }) %>

  <!-- Tools Grid -->
  <div class="space-y-4">
    <div class="flex items-center justify-between pb-1">
      <h2 class="text-sm sm:text-base font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">Available Tools in Category</h2>
      <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">
        <%= (tools || []).length %> Tools
      </span>
    </div>

    <% if (tools && tools.length) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% tools.forEach(function(tool) { %>
          <a href="/tools/<%= tool.slug %>" class="p-4 sm:p-5 rounded-2xl glass-panel tool-card border border-slate-200 dark:border-slate-800 hover:border-indigo-500/80 flex flex-col justify-between group block">
            <div class="space-y-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-sm group-hover:scale-110 group-hover:bg-indigo-600 group-hover:text-white transition-all shrink-0">
                  <i class="<%= tool.icon || 'fa-solid fa-wrench' %>"></i>
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-300 transition-colors truncate">
                    <%= tool.name %>
                  </h3>
                  <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                    <%= tool.category.replace('-', ' ') %>
                  </span>
                </div>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-200 line-clamp-2 leading-relaxed">
                <%= tool.description %>
              </p>
            </div>

            <div class="pt-3 border-t border-slate-200 dark:border-slate-800/80 mt-3 flex items-center justify-between text-xs">
              <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-bold flex items-center gap-1">
                <i class="fa-solid fa-check text-[10px]"></i> Free
              </span>
              <span class="px-2.5 py-1 rounded-lg bg-indigo-50 dark:bg-indigo-500/15 group-hover:bg-indigo-600 text-indigo-700 dark:text-indigo-300 group-hover:text-white font-bold text-[11px] transition-all flex items-center gap-1">
                <span>Open Tool</span>
                <i class="fa-solid fa-arrow-right text-[9px] group-hover:translate-x-0.5 transition-transform"></i>
              </span>
            </div>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <div class="p-10 rounded-3xl glass-panel border border-slate-800 text-center space-y-3">
        <i class="fa-solid fa-box-open text-3xl text-slate-600"></i>
        <h3 class="text-base font-bold text-slate-300">No tools found in this category yet</h3>
        <p class="text-xs text-slate-500">More tools are actively being designed and integrated.</p>
        <div class="pt-2">
          <a href="/#categories" class="px-4 py-2 rounded-xl bg-indigo-600 text-white text-xs font-bold hover:bg-indigo-500 transition-colors inline-block">
            Explore All Categories
          </a>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Bottom Ad Slot Placeholder -->
  <%- include('../partials/ad-slot', { id: 'category-bottom-banner', format: 'rectangle', label: 'Sponsored Recommendation' }) %>

</div>
