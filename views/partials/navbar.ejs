<header class="sticky top-0 z-40 glass-panel border-b border-slate-800/80 bg-slate-950/85 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-18 gap-3 sm:gap-4">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 sm:gap-3 group shrink-0 min-h-[44px]">
        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-gradient-to-tr from-indigo-600 via-indigo-500 to-purple-600 flex items-center justify-center text-white shadow-lg shadow-indigo-600/25 group-hover:scale-105 transition-transform">
          <i class="fa-solid fa-layer-group text-sm sm:text-base"></i>
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-1.5 leading-none">
            <span class="text-base sm:text-lg font-black tracking-tight text-white group-hover:text-indigo-200 transition-colors">
              ALL TOOLS
            </span>
            <span class="text-[9px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
              FREE
            </span>
          </div>
          <span class="text-[10px] sm:text-[11px] text-slate-400 font-medium mt-0.5">
            Fast • Private • Multi-Tool Suite
          </span>
        </div>
      </a>

      <!-- Search Trigger (Desktop & Tablet) -->
      <button 
        type="button" 
        onclick="openSearchModal()" 
        class="hidden sm:flex flex-1 max-w-md mx-2 px-3.5 py-2.5 min-h-[44px] rounded-xl bg-slate-900/90 hover:bg-slate-800/90 border border-slate-700/80 text-slate-400 hover:text-slate-100 text-xs sm:text-sm items-center justify-between transition-all group shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/40 cursor-pointer"
      >
        <span class="flex items-center gap-2.5 truncate">
          <i class="fa-solid fa-magnifying-glass text-indigo-400 text-xs group-hover:scale-110 transition-transform"></i>
          <span class="truncate font-medium">Search 8+ tools (e.g. JSON, QR, Titles)...</span>
        </span>
        <kbd class="inline-flex items-center gap-0.5 text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700/60 shadow-xs">
          <span>⌘</span>K
        </kbd>
      </button>

      <!-- Desktop Navigation Actions -->
      <nav class="hidden md:flex items-center gap-2.5">
        <a href="/#categories" class="text-xs font-semibold text-slate-300 hover:text-white px-3 py-2 min-h-[44px] flex items-center rounded-xl hover:bg-slate-800/60 transition-colors">
          Categories
        </a>
        <a href="/#all-tools" class="text-xs font-semibold text-slate-300 hover:text-white px-3 py-2 min-h-[44px] flex items-center rounded-xl hover:bg-slate-800/60 transition-colors">
          All Tools
        </a>

        <!-- Dark/Light Theme Toggle -->
        <button 
          type="button" 
          onclick="toggleTheme()" 
          class="w-11 h-11 min-w-[44px] min-h-[44px] rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 flex items-center justify-center transition-colors text-slate-300 hover:text-white cursor-pointer" 
          title="Toggle Dark / Light Theme"
        >
          <i id="theme-toggle-icon" class="fa-solid fa-moon text-indigo-400 text-sm"></i>
        </button>
      </nav>

      <!-- Mobile Right Actions (Min 44px Touch Targets) -->
      <div class="flex items-center gap-1.5 sm:gap-2 md:hidden">
        <!-- Mobile Search Trigger Button -->
        <button 
          type="button" 
          onclick="openSearchModal()" 
          class="w-11 h-11 min-w-[44px] min-h-[44px] rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-center text-indigo-400 hover:text-indigo-300 hover:bg-slate-800 transition-colors cursor-pointer"
          title="Search Tools"
        >
          <i class="fa-solid fa-magnifying-glass text-sm"></i>
        </button>

        <!-- Theme Toggle Button -->
        <button 
          type="button" 
          onclick="toggleTheme()" 
          class="w-11 h-11 min-w-[44px] min-h-[44px] rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-300 hover:text-white hover:bg-slate-800 transition-colors cursor-pointer"
          title="Toggle Theme"
        >
          <i class="fa-solid fa-moon text-indigo-400 text-xs"></i>
        </button>

        <!-- Mobile Menu Toggle Button -->
        <button 
          type="button" 
          onclick="toggleMobileMenu()" 
          class="w-11 h-11 min-w-[44px] min-h-[44px] rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-300 hover:text-white hover:bg-slate-800 transition-colors cursor-pointer"
          title="Open Menu"
        >
          <i class="fa-solid fa-bars text-sm"></i>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Collapsible Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-800 bg-slate-950 px-4 pt-3 pb-4 space-y-2">
    <a href="/#popular" onclick="toggleMobileMenu()" class="min-h-[44px] flex items-center px-3.5 py-2.5 rounded-xl text-sm font-semibold text-slate-200 hover:bg-slate-800 hover:text-white transition-colors">
      <i class="fa-solid fa-fire text-amber-400 w-6"></i> Popular Tools
    </a>
    <a href="/#categories" onclick="toggleMobileMenu()" class="min-h-[44px] flex items-center px-3.5 py-2.5 rounded-xl text-sm font-semibold text-slate-200 hover:bg-slate-800 hover:text-white transition-colors">
      <i class="fa-solid fa-table-cells-large text-indigo-400 w-6"></i> Categories
    </a>
    <a href="/#all-tools" onclick="toggleMobileMenu()" class="min-h-[44px] flex items-center px-3.5 py-2.5 rounded-xl text-sm font-semibold text-slate-200 hover:bg-slate-800 hover:text-white transition-colors">
      <i class="fa-solid fa-screwdriver-wrench text-purple-400 w-6"></i> All Tools Directory
    </a>
  </div>
</header>
