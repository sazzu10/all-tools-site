<div id="search-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex items-start justify-center p-4 pt-16 sm:pt-24">
  <div class="bg-slate-900 border border-slate-700/80 rounded-2xl max-w-xl w-full shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150">
    
    <!-- Search Bar Input -->
    <div class="p-3 border-b border-slate-800 flex items-center gap-3">
      <i class="fa-solid fa-magnifying-glass text-indigo-400 pl-2"></i>
      <input 
        id="global-search-input" 
        type="text" 
        placeholder="Type a tool name, topic, or category..." 
        autocomplete="off"
        class="w-full bg-transparent text-sm text-slate-100 placeholder-slate-400 focus:outline-none"
      >
      <button type="button" onclick="closeSearchModal()" class="px-2 py-1 text-xs text-slate-400 hover:text-white rounded hover:bg-slate-800">
        <kbd class="font-mono text-[10px]">ESC</kbd>
      </button>
    </div>

    <!-- Results Container -->
    <div id="search-results-container" class="max-h-[60vh] overflow-y-auto p-2 space-y-1 divide-y divide-slate-800/40">
      <!-- Injected dynamically by /js/search.js -->
    </div>

    <!-- Quick Footer Tip -->
    <div class="px-4 py-2.5 bg-slate-950/70 border-t border-slate-800 flex items-center justify-between text-[11px] text-slate-400">
      <span>Use <kbd class="font-mono px-1 bg-slate-800 rounded">↑</kbd> <kbd class="font-mono px-1 bg-slate-800 rounded">↓</kbd> to navigate</span>
      <span>Press <kbd class="font-mono px-1 bg-slate-800 rounded">ESC</kbd> to close</span>
    </div>

  </div>
</div>
