PORT=4000
NODE_ENV=development
SITE_NAME="All Tools • Free Online Utilities & Creator Tools"
SITE_URL="https://freetoolx.dpdns.org"
SITE_DESCRIPTION="Free online utilities, creator generators, developer tools, and productivity helpers. Fast, private, and accessible."
ENABLE_ADS=false
SHOW_PRO_BANNER=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Modular AI Router Configuration (Groq -> OpenRouter -> Gemini)
AI_PROVIDER_ORDER=groq,openrouter,gemini
AI_TIMEOUT_MS=15000
AI_MAX_TOKENS=1500

# AI Provider Keys (Server-side only)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
